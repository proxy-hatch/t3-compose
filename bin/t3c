#!/usr/bin/env python3
"""Run explicitly as PY="$(uv python find 3.15)" && "$PY" -I -S /path/to/bin/t3c."""
import sys
from pathlib import Path
import shlex

if (sys.implementation.name != "cpython" or
        sys.version_info < (3, 15) or
        sys.version_info.releaselevel != "final" or
        not (sys.flags.isolated and sys.flags.no_site)):
    command = 'PY="$(uv python find 3.15)" && "$PY" -I -S {}'.format(
        shlex.quote(str(Path(__file__).resolve())))
    print("Stable CPython 3.15+ with isolation and no site required; run: " + command + " version",
          file=sys.stderr)
    sys.exit(2)

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from t3compose.cli import main

sys.exit(main())
